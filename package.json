{
  "name": "hivelab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "productName": "HiveLab 合屋",
  "description": "本地多成员 AI 工作台",
  "main": "dist/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-job.mjs && node --import ./scripts/test-bootstrap.mjs --import tsx --test tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "package": "npm run build && electron-builder --win nsis portable --config electron-builder.json",
    "package:green": "node scripts/build.mjs && electron-builder --win --dir --config electron-builder.json && node scripts/package-green.mjs",
    "package:signed": "node scripts/package-signed.mjs",
    "package:green:signed": "node scripts/package-signed.mjs --green",
    "postpackage": "node scripts/package-handoff.mjs",
    "deploy": "node scripts/deploy-runtime.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:mac-foundation": "node --import ./scripts/test-bootstrap.mjs --import tsx --test tests/macos-foundation.test.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "7zip-bin": "5.2.0",
    "docx-preview": "0.4.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.51.0",
    "node-pty": "1.2.0-beta.15",
    "npm": "12.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "undici": "8.11.2",
    "webwallgl": "3.0.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.288",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@openai/codex": "0.160.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "allowScripts": {
    "@anthropic-ai/claude-code@2.1.288": true,
    "esbuild@0.28.2": true,
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  }
}
